<mxfile host="app.diagrams.net" modified="2026-09-14T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="sr1620-software-items-code-map" name="软件项代码映射架构图">
    <mxGraphModel dx="1600" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="SR1620 医生程控软件 软件项代码映射架构图" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=22;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="310" y="15" width="980" height="32" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="基于 SR1620 需求规格书的软件项划分；括号中为当前代码识别到的主要实现落点。该图不是 Java 类图，跨软件项调用以当前实现路径为依据。" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#4B5563;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="220" y="49" width="1160" height="30" as="geometry"/></mxCell>

        <mxCell id="appBoundary" value="SR1620 医生程控软件（Android 平板应用）" style="swimlane;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=16;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="65" y="105" width="1470" height="770" as="geometry"/></mxCell>

        <mxCell id="si01" value="&lt;b&gt;SI-01 应用管理&lt;/b&gt;&lt;br&gt;启动、授权、登录、设置、App 升级入口&lt;br&gt;&lt;font color='#475569'&gt;代码：modules/splash；modules/login；modules/setting&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=12;fontColor=#0C4A6E;align=left;spacingLeft=10;" vertex="1" parent="appBoundary"><mxGeometry x="30" y="50" width="285" height="92" as="geometry"/></mxCell>
        <mxCell id="si02" value="&lt;b&gt;SI-02 连接管理&lt;/b&gt;&lt;br&gt;SR1811 蓝牙、搜索、重连；IPG/EPG 搜索、连接、配对&lt;br&gt;&lt;font color='#475569'&gt;代码：connectcontroller；connectipg；pair&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=12;fontColor=#0C4A6E;align=left;spacingLeft=10;" vertex="1" parent="appBoundary"><mxGeometry x="350" y="50" width="305" height="92" as="geometry"/></mxCell>
        <mxCell id="si03" value="&lt;b&gt;SI-03 协议通讯&lt;/b&gt;&lt;br&gt;命令封装、发送、响应、超时、错误码与校验&lt;br&gt;&lt;font color='#475569'&gt;代码：ScenerayAndroidLibrary-feat-1.5.0；protocol 调用路径&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;fontColor=#78350F;align=left;spacingLeft=10;" vertex="1" parent="appBoundary"><mxGeometry x="690" y="50" width="340" height="92" as="geometry"/></mxCell>
        <mxCell id="si09" value="&lt;b&gt;SI-09 后台服务&lt;/b&gt;&lt;br&gt;远程历史、上传、网络任务、日志归档&lt;br&gt;&lt;font color='#475569'&gt;代码：abs/api；service；service/log；history/remote&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7E22CE;fontSize=12;fontColor=#581C87;align=left;spacingLeft=10;" vertex="1" parent="appBoundary"><mxGeometry x="1065" y="50" width="370" height="92" as="geometry"/></mxCell>

        <mxCell id="si04" value="&lt;b&gt;SI-04 患者配置&lt;/b&gt;&lt;br&gt;患者、植入、电极、核团、通道与设备归属&lt;br&gt;&lt;font color='#475569'&gt;代码：program/patient；FragPatient；VMPatient&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#16A34A;fontSize=12;fontColor=#14532D;align=left;spacingLeft=10;" vertex="1" parent="appBoundary"><mxGeometry x="30" y="190" width="285" height="92" as="geometry"/></mxCell>
        <mxCell id="si05" value="&lt;b&gt;SI-05 程序配置&lt;/b&gt;&lt;br&gt;标准/循环/定时程序、参数、患者限制与总览&lt;br&gt;&lt;font color='#475569'&gt;代码：program/modify；program/limit；frame/time；frame/program&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#16A34A;fontSize=12;fontColor=#14532D;align=left;spacingLeft=10;" vertex="1" parent="appBoundary"><mxGeometry x="350" y="190" width="375" height="92" as="geometry"/></mxCell>
        <mxCell id="si06" value="&lt;b&gt;SI-06 治疗控制&lt;/b&gt;&lt;br&gt;读写、运行/停止、紧急停止、自增、定时、模式切换&lt;br&gt;&lt;font color='#475569'&gt;代码：ActProgramFrame；VMSwitchProgram；VMWorkMode&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=2;fontSize=12;fontColor=#14532D;align=left;spacingLeft=10;" vertex="1" parent="appBoundary"><mxGeometry x="760" y="190" width="350" height="92" as="geometry"/></mxCell>
        <mxCell id="si07" value="&lt;b&gt;SI-07 测量监测&lt;/b&gt;&lt;br&gt;阻抗、有效刺激、电池、系统信息、运行统计和告警&lt;br&gt;&lt;font color='#475569'&gt;代码：frame/real；use/measure；use/power；use/info；use/log&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#16A34A;fontSize=12;fontColor=#14532D;align=left;spacingLeft=10;" vertex="1" parent="appBoundary"><mxGeometry x="1145" y="190" width="290" height="92" as="geometry"/></mxCell>

        <mxCell id="si08" value="&lt;b&gt;SI-08 数据记录&lt;/b&gt;&lt;br&gt;患者/设备/程序/测量/状态快照、本地记录与历史查询&lt;br&gt;&lt;font color='#475569'&gt;代码：dal；IPGSnapFacade；dal/update；history；overview&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;fontSize=12;fontColor=#4C1D95;align=left;spacingLeft=10;" vertex="1" parent="appBoundary"><mxGeometry x="245" y="350" width="450" height="92" as="geometry"/></mxCell>
        <mxCell id="si10" value="&lt;b&gt;SI-10 演示模式&lt;/b&gt;&lt;br&gt;虚拟 IPG/EPG、演示数据和真实设备隔离&lt;br&gt;&lt;font color='#92400E'&gt;需求：PAD.1.4.1；本轮未确认独立专用代码目录，待补充映射&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F59E0B;dashed=1;fontSize=12;fontColor=#78350F;align=left;spacingLeft=10;" vertex="1" parent="appBoundary"><mxGeometry x="770" y="350" width="450" height="92" as="geometry"/></mxCell>

        <mxCell id="internalNote" value="实现边界提示：现有 `program` 目录包含程序配置、治疗控制、测量和状态展示等多个软件项；图中按需求职责重新归属，不宣称当前包结构已完全隔离。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;dashed=1;fontSize=11;fontColor=#78350F;align=left;spacingLeft=10;" vertex="1" parent="appBoundary"><mxGeometry x="190" y="505" width="1085" height="45" as="geometry"/></mxCell>

